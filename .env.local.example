# Supabase — create a new project at supabase.com (separate from Northside BJJ)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for OG image metadataBase and sitemap
NEXT_PUBLIC_SITE_URL=https://dialogtherapy.ie

# Formspree — create a form at formspree.io, paste the ID here
# Then replace DIALOG_FORMSPREE_ID in components/ContactForm.tsx
FORMSPREE_FORM_ID=xxxxxxxxxxx

# Search indexing — off by default while the site has placeholder content.
# Set to true on the production domain at launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
